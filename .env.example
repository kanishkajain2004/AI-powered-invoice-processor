# Copy to .env for local overrides, or set these as environment variables (e.g. in the
# Render dashboard). Every value has a working default; nothing here is a secret.

# --- Storage --------------------------------------------------------------------------------
# One directory for both the database and the uploads, e.g. a mounted disk on Render.
# DATA_DIR=/var/data
# Or set each one directly (these win over DATA_DIR). Use absolute paths.
# DATABASE_URL=sqlite:////absolute/path/to/invoices.db
# UPLOAD_DIR=/absolute/path/to/uploads

# Create the seed purchase orders (PO-5001 ... PO-5004) at startup if they are missing.
# Safe to leave on: it never duplicates or overwrites. Render sets this to true.
SEED_ON_STARTUP=false

# --- Networking -----------------------------------------------------------------------------
# Where the Streamlit frontend (and scripts/demo.py) reach the API. On Render, use the API
# service's public URL, e.g. https://zamp-invoice-api.onrender.com
API_BASE_URL=http://localhost:8000
# scripts/start_api.sh and scripts/start_ui.sh listen on HOST:PORT. Render sets PORT itself.
# HOST=0.0.0.0
# PORT=8000

# Extraction is fully local and rule-based (PyMuPDF, plus Tesseract for scans); no API key is needed.

# How to read numeric dates such as 03/04/2026: DMY (3 April) or MDY (4 March)
DATE_ORDER=DMY

# Pages with fewer alphanumeric characters than this, that also contain images or
# drawings, are treated as scanned and sent to OCR
MIN_TEXT_CHARS_PER_PAGE=30
MAX_PAGES=20
MAX_UPLOAD_MB=20

# OCR (only used for scanned pages). Needs the Tesseract binary installed.
# Set TESSERACT_CMD if tesseract is not on PATH, e.g. /opt/homebrew/bin/tesseract
# TESSERACT_CMD=
OCR_LANG=eng
OCR_DPI=300

# Validation (illustrative values)
# Invoice total may differ from the PO approved amount by up to this % of the PO amount
AMOUNT_TOLERANCE_PCT=1.0
# Rounding allowance for subtotal + tax = total and line arithmetic
ARITHMETIC_TOLERANCE=0.01

# Logging level for the application's own loggers (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
